# Copy to .env, fill in, load into the environment (e.g. `set -a; . ./.env; set +a`). Never commit .env.

LAZARUS_DB=lazarus.db
LAZARUS_WORKER_ID=worker-1

# --- SMS via Twilio (leave unset to run without sending anything) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                      # E.164 sender, or use a messaging service:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK=

# --- Inbound webhooks (lazarus serve) ---
LAZARUS_PUBLIC_URL=               # e.g. https://lazarus.yourdomain.example (behind a TLS proxy/tunnel)
LAZARUS_INBOUND_SECRET=           # >=32 random chars, for the generic /webhooks/inbound endpoint

# --- Email via SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_UNSUBSCRIBE_MAILTO=
SMTP_UNSUBSCRIBE_URL=

# --- CRM handoff webhook (optional): signed POST for every interested reply ---
LAZARUS_WEBHOOK_URL=
LAZARUS_WEBHOOK_SECRET=           # >=16 chars; receiver verifies X-Lazarus-Signature

# --- Claude (optional) ---
LAZARUS_LLM=none                  # none | anthropic
ANTHROPIC_API_KEY=
LAZARUS_LLM_MODEL=claude-opus-5-5
LAZARUS_LLM_EFFORT=low
LAZARUS_LLM_BUDGET_USD=5
