// The portal deploys as its OWN worker from its OWN directory, with its own
// database and its own lockfile (SPEC trap B9). Point your build at this
// directory with a "root directory" setting OR pass --config — never both, or
// the path doubles (staff-portal/staff-portal/wrangler.jsonc).
//
// wrangler v4 REPLACES the deployed variable set with `vars` below on every
// deploy: any variable you set in the dashboard must also be here or the next
// deploy silently wipes it. Secrets (wrangler secret put) are not affected.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staff-portal",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request reaches the worker first, so nothing — not even a CSS
    // file — is served to a visitor the gate has refused.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "staff-portal",
      // wrangler d1 create staff-portal  → paste the id here
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "ORG_NAME": "Acme Inc.",
    "ORG_CODE": "ACME",
    "RP_ID": "staff.example.com",
    "ORIGIN": "https://staff.example.com",
    "PBKDF2_ITERATIONS": "600000"
  },
  "observability": { "enabled": true }
}
